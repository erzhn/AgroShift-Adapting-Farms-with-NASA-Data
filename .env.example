# Скопируйте в .env  (cp .env.example .env) и поправьте при необходимости.
# .env в git НЕ коммитится.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=agroshift
POSTGRES_USER=agroshift
POSTGRES_PASSWORD=agroshift
# порт Postgres на вашей машине (5433 — чтобы не конфликтовать с локальным Postgres)
POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=3000

# Для запуска API без Docker (uvicorn с хоста). В docker compose переопределяется автоматически.
DATABASE_URL=postgresql+psycopg://agroshift:agroshift@localhost:5433/agroshift

# --- Приложение ---
ENVIRONMENT=dev
# Демо-режим (раздел 14.1): вход без SMS, роль берётся из заголовка X-Demo-Role
DEMO_MODE=true
JWT_SECRET=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# --- ИИ-помощник (раздел 10). Провайдер вынесен за адаптер app/ai/llm.py ---
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# --- NASA Earthdata (нужно только для IMERG / HLS / MODIS; POWER работает без ключа) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
